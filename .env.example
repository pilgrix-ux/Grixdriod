# Public browser configuration. Both values are compiled into the Vite bundle.
# Use only your Supabase project URL and an sb_publishable_... API key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY

# Never put an sb_secret_... key or legacy service_role JWT in a VITE_ variable.
# Optional public HTTPS base URL for the MediaMTX WHEP/WebRTC viewer.
VITE_GRIXDROID_WHEP_BASE_URL=https://your-stream-host.example

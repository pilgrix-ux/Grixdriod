# Public browser configuration. These values are safe to expose in the built website.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Never add a service-role or secret API key to a VITE_ variable.
# Optional public HTTPS base URL for the MediaMTX WHEP/WebRTC viewer.
VITE_GRIXDROID_WHEP_BASE_URL=https://your-stream-host.example

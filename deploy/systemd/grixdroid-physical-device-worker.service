[Unit]
Description=GRIXDroid verified physical Android handset worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=grixdroid
Group=grixdroid
WorkingDirectory=/opt/grixdroid
Environment=HOME=/var/lib/grixdroid/home
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/test -r /etc/grixdroid/physical-worker.env
ExecStart=/usr/bin/node --env-file=/etc/grixdroid/physical-worker.env server/physical-device-worker.mjs
Restart=always
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
UMask=0077
StateDirectory=grixdroid
StateDirectoryMode=0700
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

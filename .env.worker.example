# Private Android worker configuration. Keep this file off GitHub.
# Copy to .env.worker and replace every placeholder.

# Dedicated GRIXDroid Supabase project only.
SUPABASE_URL=https://olbqxgnhozafcckcoapx.supabase.co
# Modern secret API key. Send this in the apikey header only.
# Generate it in Supabase Settings > API Keys. Never put it in a VITE_ variable.
SUPABASE_API_KEY=sb_secret_replace_with_server_secret

# Privileged JWT for the worker SQL RPCs' role check.
# Use the legacy service_role JWT from Settings > API Keys > Legacy API Keys.
# It is a SERVER SECRET. This is sent only as Authorization: Bearer.
SUPABASE_SERVICE_ROLE_JWT=replace_with_server_only_service_role_jwt

# Temporary fallback for older projects: if using one legacy service_role key,
# you may set SUPABASE_SERVICE_ROLE_KEY instead of the two variables above.
# SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_jwt

# A worker identity; a UUID is generated once and should stay stable for this host.
GRIXDROID_WORKER_ID=00000000-0000-4000-8000-000000000001
GRIXDROID_WORKER_LABEL=my-android-worker
GRIXDROID_MAX_DEVICES=1
GRIXDROID_POLL_MS=5000

# Android SDK installed on the worker host.
ANDROID_SDK_ROOT=/opt/android-sdk
# Full Android 15 (API 35) Emulator image with Play Store + Google Play services.
GRIXDROID_SYSTEM_IMAGE=system-images;android-35;google_apis_playstore;x86_64

# This folder must be on durable disk. Never put it in /tmp or an ephemeral container layer.
GRIXDROID_DATA_ROOT=/var/lib/grixdroid

# Keep the local worker API on loopback during development.
GRIXDROID_WORKER_HOST=127.0.0.1
GRIXDROID_WORKER_PORT=8788
# Optional local API token. If blank, the worker generates one and prints it once at startup.
GRIXDROID_WORKER_API_TOKEN=

# Use auto on a host with KVM/HVF/WHPX. No-KVM software mode is very slow:
# set GRIXDROID_ACCEL=off and GRIXDROID_ENABLE_SOFTWARE_EMULATION=1 only for development.
GRIXDROID_ACCEL=auto
GRIXDROID_GPU_MODE=software
GRIXDROID_ENABLE_SOFTWARE_EMULATION=0

# Optional H.264 -> WebRTC publishing. Install a matching scrcpy server JAR and an FFmpeg build with the WHIP muxer.
# Leave these unset to boot Android without a WebRTC stream.
SCRCPY_SERVER_PATH=
SCRCPY_VERSION=
FFMPEG_PATH=ffmpeg
GRIXDROID_WHIP_BASE_URL=https://your-stream-host.example
GRIXDROID_STREAM_PUBLISH_TOKEN=replace_with_a_random_32_plus_character_secret

# Do not expose the worker API publicly without a private HTTPS gateway.
GRIXDROID_WORKER_ALLOW_REMOTE=0
GRIXDROID_WORKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

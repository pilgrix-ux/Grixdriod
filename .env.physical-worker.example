# Private, one-handset physical Android worker. Keep this file out of Git.
# Copy to .env.physical-worker and replace every placeholder.
#
# Use one unique worker UUID, port and state directory for each physical handset.
# Do not reuse the same UUID for an Emulator worker or another physical phone.

SUPABASE_URL=https://olbqxgnhozafcckcoapx.supabase.co
SUPABASE_API_KEY=sb_secret_replace_with_server_secret
SUPABASE_SERVICE_ROLE_JWT=replace_with_server_only_service_role_jwt

GRIXDROID_WORKER_ID=00000000-0000-4000-8000-000000000011
GRIXDROID_WORKER_LABEL=physical-samsung-lab-phone
GRIXDROID_PHYSICAL_WORKER_PORT=8790
GRIXDROID_POLL_MS=5000
GRIXDROID_ACTION_POLL_MS=350

# Exact allowlisted target ID from the GRIXDroid selector.
# Allowed: samsung_galaxy_s22, samsung_galaxy_s23, samsung_galaxy_s24,
# samsung_galaxy_s24_ultra, oppo_find_x8_pro, xiaomi_14_ultra
GRIXDROID_PHYSICAL_DEVICE_MODEL=samsung_galaxy_s22

# USB ADB serial from the local adb devices -l output. Never use Wi-Fi ADB.
GRIXDROID_PHYSICAL_DEVICE_SERIAL=replace_with_usb_adb_serial

# Read these values from the exact handset using docs/PHYSICAL_DEVICE_WORKER.md.
GRIXDROID_PHYSICAL_ANDROID_VERSION=14
GRIXDROID_PHYSICAL_PRODUCT_MODEL=replace_with_ro_product_model
GRIXDROID_PHYSICAL_HARDWARE_MODEL=replace_with_ro_product_device
GRIXDROID_PHYSICAL_BUILD_FINGERPRINT=replace_with_full_ro_build_fingerprint

# Worker refuses devices containing Android accounts or secondary users/profiles.
# Reset uninstalls session-added apps, clears third-party app data and shared folders.
# This is destructive. Change to 1 only on a dedicated, account-free lab handset.
GRIXDROID_PHYSICAL_ENABLE_RESET=0

# Renew the owner-scoped session lease every ~30 seconds while the worker is live.
GRIXDROID_PHYSICAL_SESSION_LEASE_MS=120000
GRIXDROID_PHYSICAL_SESSION_IDLE_MS=3600000
GRIXDROID_DATA_ROOT=/var/lib/grixdroid
GRIXDROID_PHYSICAL_STATE_DIR=/var/lib/grixdroid/physical-worker-samsung-s22

# Streaming uses the existing MediaMTX gateway/auth callback as Pixel workers do.
SCRCPY_SERVER_PATH=/opt/grixdroid/scrcpy-server.jar
SCRCPY_VERSION=replace_with_exact_scrcpy_server_version
FFMPEG_PATH=ffmpeg
GRIXDROID_WHIP_BASE_URL=https://stream.example.com
GRIXDROID_STREAM_PUBLISH_TOKEN=replace_with_random_secret_at_least_32_characters

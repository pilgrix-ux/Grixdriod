{
  "name": "grixdroid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build --target web",
    "build": "bash scripts/vercel-build.sh",
    "preview": "vite preview",
    "test": "cargo test --lib",
    "device-bridge": "node server/adb-bridge.mjs",
    "device-worker": "node --env-file=.env.worker server/cloud-worker.mjs",
    "test:worker": "node --test server/*.test.mjs",
    "mediamtx-auth": "node --env-file=.env.mediamtx-auth server/mediamtx-auth.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}
